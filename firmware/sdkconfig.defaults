# ---- Target / flash / PSRAM (Waveshare ESP32-S3-RLCD-4.2) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- Partition table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- FreeRTOS tick (LVGL timing) ----
CONFIG_FREERTOS_HZ=1000

# ---- Power management ----
#
# Without this the CPU only ever drops to the FreeRTOS idle task, at a fixed
# frequency, and never enters a low-power state. Turning it on allows two things:
#
#   dynamic frequency scaling - the CPU drops to 80 MHz when there is no work,
#   which is most of the time for a board that repaints once a minute.
#
#   automatic light sleep - with WiFi modem sleep already on, the system can sleep
#   between DTIM beacons instead of spinning through the idle task.
#
# The costs are real and are why this is a separate change: interrupt latency goes
# up, RTOS timers get coarser, and light sleep can interfere with USB-Serial/JTAG,
# which is how this board is flashed and monitored. If flashing starts failing, or
# the console goes quiet, this block is the first thing to remove.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Let the CPU scale down to 80 MHz. The 40 MHz step is not used: the flash and octal
# PSRAM are both on 80 MHz dividers, and a lower CPU clock would put them out of
# ratio for no useful saving.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# ---- Task stacks ----
# The main task performs the DeepSeek balance request, which runs a TLS handshake
# and walks the CA bundle. The 3584-byte default overflowed the FreeRTOS stack
# canary and rebooted the board in a loop the moment a balance was fetched - the
# panel never got as far as rendering, so the screen just looked frozen.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Report which task overflows instead of only rebooting.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# ---- LVGL ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_LOG=y

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- HTTP client ----
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
